generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User roles as defined in the SRS package structure [cite: 415]
enum Role {
  THERAPIST
  GUARDIAN
  CHILD
}

// Base User model handling authentication fundamentals [cite: 416]
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   // Nullable for Google OAuth users [cite: 295, 416]
  role          Role?   // Set after OAuth registration
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile links
  therapistProfile TherapistProfile?
  guardianProfile  GuardianProfile?
  childProfile     ChildProfile?
}

// Therapist Profile: Holds clinical authority and manages templates [cite: 417, 418]
model TherapistProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])

  // Managed relationships [cite: 422]
  children        ChildProfile[]
  storyTemplates  StoryTemplate[]

  // Clinical metadata
  specialization  String?
}

// Child Profile: Tracks behavioral goals and progress [cite: 419]
model ChildProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])

  // Clinical relationships [cite: 422]
  therapistId     String
  therapist       TherapistProfile @relation(fields: [therapistId], references: [id])

  guardianId      String?         @unique
  guardian        GuardianProfile? @relation(fields: [guardianId], references: [id])

  // Behavioral data [cite: 419]
  behavioralGoals String[]
  progressStats   Json?           // Flexible storage for session analytics [cite: 631]
  sessions        Session[]
  rewards         Reward[]
}

// Guardian Profile: Facilitator class [cite: 421]
model GuardianProfile {
  id              String          @id @default(cuid())
  userId          String          @unique
  user            User            @relation(fields: [userId], references: [id])

  child           ChildProfile?   // 1-to-1 relationship with Child [cite: 422]
}

// Story Template: "Seed data" for AI generation [cite: 227, 418]
model StoryTemplate {
  id              String          @id @default(cuid())
  therapistId     String
  therapist       TherapistProfile @relation(fields: [therapistId], references: [id])

  targetBehavior  String          // e.g., "Turn-taking" [cite: 227]
  setting         String          // e.g., "Playground" [cite: 227]
  characterDetails String
  emotionalTone   String
  promptSuggestion String

  sessions        Session[]
}

// Session: Represents an active or historical therapy playthrough [cite: 424, 631]
model Session {
  id              String          @id @default(cuid())
  childId         String
  child           ChildProfile     @relation(fields: [childId], references: [id])
  templateId      String
  template        StoryTemplate    @relation(fields: [templateId], references: [id])

  status          SessionStatus    @default(ACTIVE)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?

  nodes           StoryNode[]
  interactions    Interaction[]
}

enum SessionStatus {
  ACTIVE
  PAUSED_FOR_REVIEW // Triggered by low Confidence Score
  COMPLETED
}

// StoryNode: Individual AI-generated story segments [cite: 166, 252]
model StoryNode {
  id              String          @id @default(cuid())
  sessionId       String
  session         Session         @relation(fields: [sessionId], references: [id])

  textContent     String
  imageUrl        String?         // From Text-to-Image service [cite: 234]
  audioUrl        String?         // From Text-to-Speech service [cite: 252]

  confidenceScore Float           // CSE metric (0.0 - 1.0) [cite: 451, 582]
  isApproved      Boolean          @default(false) // Therapist approval [cite: 418]

  choices         Choice[]
}

// Choices: Behavioral options presented to the child [cite: 252, 391]
model Choice {
  id              String          @id @default(cuid())
  nodeId          String
  node            StoryNode       @relation(fields: [nodeId], references: [id])

  text            String
  behavioralTag   String?         // Positive/Negative/Neutral for analytics [cite: 631]
  interactions    Interaction[]
}

// Interaction: Detailed logs for Behavioral Analytics [cite: 268, 631]
model Interaction {
  id              String          @id @default(cuid())
  sessionId       String
  session         Session         @relation(fields: [sessionId], references: [id])
  choiceId        String
  choice          Choice          @relation(fields: [choiceId], references: [id])

  timeTakenMs     Int             // Engagement metric [cite: 631]
  timestamp       DateTime         @default(now())
}

// Reward: Gamification elements [cite: 393, 638]
model Reward {
  id              String          @id @default(cuid())
  childId         String
  child           ChildProfile    @relation(fields: [childId], references: [id])

  type            String          // e.g., "BADGE", "COSMETIC" [cite: 638]
  name            String          // e.g., "Star", "Golden Dinosaur" [cite: 393]
  earnedAt        DateTime        @default(now())
}
