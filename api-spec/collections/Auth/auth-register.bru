meta {
  name: auth/register
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "user1@example.com",
    "password": "test123456",
    "role": "GUARDIAN"
  }
}

script:post-response {
  const token = res.body.access_token
  bru.setVar("access_token", token)
}

settings {
  encodeUrl: true
  timeout: 0
}
