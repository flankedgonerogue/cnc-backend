meta {
  name: auth/login
  type: http
  seq: 2
}

post {
  url: {{BASE_URL}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{EMAIL}}",
    "password": "{{PASSWORD}}"
  }
}

script:post-response {
  const token = res.body.access_token
  bru.setEnvVar("ACCESS_TOKEN", token)
}

settings {
  encodeUrl: true
  timeout: 0
}
