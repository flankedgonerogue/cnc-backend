meta {
  name: auth/register
  type: http
  seq: 1
}

post {
  url: {{BASE_URL}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "firstName": "John",
    "lastName": "Doe",
    "email": "{{ADMIN_EMAIL}}",
    "password": "{{ADMIN_PASSWORD}}",
    "role": "ADMIN"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
