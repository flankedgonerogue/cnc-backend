meta {
  name: Update My Profile
  type: http
  seq: 2
}

patch {
  url: {{BASE_URL}}/profiles/me
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "Jane",
    "lastName": "Doe",
    "displayName": "Jane Doe",
    "timezone": "America/New_York",
    "locale": "en-US",
    "specialization": "Cognitive Behavioral Therapy",
    "licenseNumber": "LIC-12345",
    "bio": "Therapist specializing in CBT and mindfulness.",
    "clinicName": "Downtown Wellness Center",
    "interventionThreshold": 5,
    "relationship": "guardian",
    "phoneNumber": "+1-555-0100",
    "emergencyContactInfo": "John Doe +1-555-0199",
    "notificationPreferences": {
      "email": true,
      "sms": false
    },
    "dateOfBirth": "2012-05-20",
    "interests": [
      "art",
      "music"
    ],
    "triggers": [
      "loud_noises",
      "crowds"
    ],
    "behavioralGoals": {
      "daily": ["breathing_exercise"],
      "weekly": ["social_interaction"]
    },
    "gamificationData": {
      "currentPoints": 120,
      "level": 3,
      "unlockedAvatarItems": [
        "hat_1",
        "shirt_2"
      ]
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
