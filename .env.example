# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:3001

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# Chronicles N Conversations Engine - AI Configuration
# Gemini API for Story Generation
GEMINI_API_KEY=your-gemini-api-key-here

# Nano Banana API for Image Generation
NANO_BANANA_API_KEY=your-nano-banana-api-key-here
NANO_BANANA_BASE_URL=https://api.nanobanana.ai

# Storage Configuration
# STORAGE_TYPE can be 'local' (default) or 's3'
STORAGE_TYPE=local

# Local Storage Configuration (used when STORAGE_TYPE=local)
UPLOADS_DIR="uploads"
UPLOADS_BASE_URL="/uploads"
AVATAR_PLACEHOLDER_URL="https://placehold.co/400x400"

# AWS S3 Storage Configuration (used when STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=us-east-1
# Optional: Custom S3 URL (defaults to: https://BUCKET_NAME.s3.REGION.amazonaws.com)
AWS_S3_URL=https://your-custom-s3-url.com

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Puck
PROMPTS_DIR=prompts
